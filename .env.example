# Buyer wallet. Use a fresh testnet-only key; it signs escrow payments to the Telegraph node.
EVM_PRIVATE_KEY=0x...
EVM_ADDRESS=0x...

# Telegraph testnet node
TELEGRAPH_NODE=https://devnode.telegraphprotocol.com

# Funding (scripts/fund.mjs): Ethereum Sepolia RPC, test USDC (open mint) and the escrow Diamond
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
USDC=0xcc194e1a843B658526D0D5C431f670028582Ae17
DIAMOND=0x72a70e949362670Bf8bceAd24eFC5b8f950aa08b

# Server
PORT=4380
DAILY_BUDGET_USD=3      # the fleet's shared intelligence budget per UTC day
TICK_SECONDS=300        # one automatic decision every N seconds; 0 turns the loop off
MAX_REBUYS=2            # how many other miners to try after a refused answer
DATA_DIR=./data         # SQLite ledger lives here; mount a volume in production
